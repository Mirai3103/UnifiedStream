{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UnifiedStream",
  "version": "0.1.0",
  "identifier": "com.laffy.unifiedstream",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "UnifiedStream",
        "width": 820,
        "height": 900,
        "minWidth": 460,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb"],
    "publisher": "UnifiedStream contributors",
    "homepage": "https://github.com/Mirai3103/UnifiedStream",
    "category": "Video",
    "shortDescription": "Use an Android phone as Linux camera, microphone, and speaker.",
    "longDescription": "UnifiedStream connects an Android phone to a Linux PC over a trusted local network and exposes virtual camera and audio devices.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
